# JustRL2 smoke test on ONE node with 8 GPUs (4 actor + 4 critic, colocated).
# Only for checking that the pipeline runs end to end; numbers are not meaningful.
#     bash justrl2/train.sh justrl2/configs/debug-1node-8gpu.env

: ${EXP_TAG:=justrl2_debug}
: ${GPUS_PER_NODE:=8}
: ${ACTOR_NUM_GPUS_PER_NODE:=4}       # actor and critic each take half of the node
: ${NUM_ROLLOUT:=10}
: ${ROLLOUT_BATCH_SIZE:=4}
: ${N_SAMPLES_PER_PROMPT:=4}
: ${OVER_SAMPLING_BATCH_SIZE:=8}
: ${ROLLOUT_MAX_RESPONSE_LEN:=8192}
: ${ROLLOUT_MAX_CONTEXT_LEN:=16384}
: ${CONTEXT_PARALLEL_SIZE:=1}
: ${MAX_TOKENS_PER_GPU:=8192}
: ${SGLANG_MAX_TOTAL_TOKENS:=131072}
: ${SGLANG_MEM_FRACTION:=0.6}
: ${OVERLONG_BUFFER_LEN:=1638}        # 20% of 8192
: ${NUM_CRITIC_ONLY_STEPS:=2}
: ${EVAL_INTERVAL:=1000}
: ${SAVE_INTERVAL:=5}
: ${HF_SAVE_INTERVAL:=0}

source "$(dirname "${BASH_SOURCE[0]}")/minicpm5-2b-math-128k.env"
