# JustRL2 — MiniCPM-2B, 128k-context math RL (release recipe)
#
# Every value here is a default: anything already exported in your shell wins
# (`: ${VAR:=default}`), so you can override a knob without editing this file, e.g.
#     NUM_ROLLOUT=50 bash justrl2/train.sh justrl2/configs/minicpm-2b-math-128k.env
#
# Cluster: 16 x 8 H100 (actor 8 nodes + critic 8 nodes, colocated with sglang).

# ---- experiment / paths ----------------------------------------------------
: ${EXP_TAG:=justrl2_minicpm_2b_math128k}
: ${MODELS_DIR:=$PWD/models}          # from justrl2/prepare_model.sh
: ${DATA_DIR:=$PWD/datasets}          # from justrl2/prepare_data.py
: ${HF_MODEL_DIR:=$MODELS_DIR/MiniCPM-2B}
: ${MEGATRON_MODEL_PATH:=$MODELS_DIR/MiniCPM-2B-torch_dist}
: ${SAVE_ROOT:=$PWD/runs}
: ${TRAIN_FILE:="$DATA_DIR/justrl2-math-s9.jsonl"}
: ${TEST_FILE:="aime2024 $DATA_DIR/aime-2024.jsonl aime2025 $DATA_DIR/aime-2025.jsonl aime2026 $DATA_DIR/aime-2026.jsonl"}

# ---- rollout ---------------------------------------------------------------
: ${NUM_ROLLOUT:=500}                 # total training steps
: ${ROLLOUT_BATCH_SIZE:=60}           # prompts per step  -> GBS = 60 * 8 = 480
: ${N_SAMPLES_PER_PROMPT:=8}
: ${OVER_SAMPLING_BATCH_SIZE:=120}    # 2x over-sampling; first finished 60 groups train
: ${DYNAMIC_SAMPLING:=1}              # DAPO filter: drop groups with zero reward variance
: ${ENABLE_PARTIAL_ROLLOUT:=1}        # unfinished long trajectories carry over to next step
: ${ROLLOUT_MAX_PROMPT_LEN:=2048}
: ${ROLLOUT_MAX_RESPONSE_LEN:=126976}
: ${ROLLOUT_MAX_CONTEXT_LEN:=131072}
: ${ROLLOUT_TEMPERATURE:=1.0}

# ---- JustRL2 core ----------------------------------------------------------
: ${GAE_LAMBDA_K:=0.5}                # lambda_i = k^(1/L_i): first token keeps fraction k of terminal credit
: ${CRITIC_VALUE_BIAS_INIT:=0.52}     # value-head bias = expected mean reward (weight is zero-init)
: ${NUM_CRITIC_ONLY_STEPS:=30}        # critic-only warmup; actor frozen
: ${CRITIC_EXCLUDE_OLP:=1}            # critic regresses reward WITHOUT the overlong penalty
: ${GAMMA:=1.0}                       # must be 1 for the length-adaptive lambda

# ---- PPO -------------------------------------------------------------------
: ${LR:=1e-6}
: ${CRITIC_LR:=5e-6}
: ${CRITIC_LR_WARMUP_ITERS:=10}
: ${EPS_CLIP:=0.2}
: ${EPS_CLIP_HIGH:=0.28}              # clip-higher
: ${VALUE_CLIP:=0.2}
: ${OVERLONG_BUFFER_LEN:=25395}       # DAPO soft overlong punishment: last 20% of 126976
: ${OVERLONG_PENALTY_FACTOR:=1.0}
: ${TIS_CLIP_LOW:=0.5}                # truncated importance sampling (IcePop)
: ${TIS_CLIP:=5.0}

# ---- parallelism / memory --------------------------------------------------
: ${TENSOR_MODEL_PARALLEL_SIZE:=1}
: ${CONTEXT_PARALLEL_SIZE:=4}
: ${MAX_TOKENS_PER_GPU:=16000}
: ${LOG_PROBS_CHUNK_SIZE:=2048}
: ${SGLANG_MEM_FRACTION:=0.83}
: ${SGLANG_MAX_RUNNING_REQUESTS:=64}
: ${SGLANG_MAX_TOTAL_TOKENS:=1441792} # ~11 full-128k sequences per engine
: ${SGLANG_ATTENTION_BACKEND:=fa3}

# ---- DSpark speculative decoding (optional; empty = off) -------------------
: ${DSPARK_DRAFT_MODEL_PATH:=}        # e.g. $MODELS_DIR/MiniCPM-2B-DSpark-5L
: ${DSPARK_BLOCK_SIZE:=7}
: ${DSPARK_DRAFT_WINDOW:=4096}

# ---- eval / checkpoint -----------------------------------------------------
: ${EVAL_INTERVAL:=1000}              # the reference run evaluated offline from HF exports instead
: ${EVAL_TEMPERATURE:=1.0}
: ${EVAL_TOP_P:=0.95}
: ${N_SAMPLES_PER_EVAL_PROMPT:=4}
: ${SAVE_INTERVAL:=5}
: ${HF_SAVE_INTERVAL:=5}              # HF export of the actor every 5 steps (0 = off)

# ---- tracking --------------------------------------------------------------
: ${USE_WANDB:=0}
: ${USE_SWANLAB:=0}
